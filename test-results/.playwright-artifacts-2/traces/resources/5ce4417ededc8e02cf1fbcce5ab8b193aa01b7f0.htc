3:["$","div","pol_tc5_t",{"children":[["$","h2",null,{"id":"policy-s5","style":{"fontSize":21,"marginBottom":10},"children":[5,". ","Digital products"]}],[["$","p","0",{"children":"Digital itineraries (PDF) and VIP map access are delivered in your account. VIP access costs $19 for 3 months from purchase, with no automatic renewal, or $60 for lifetime access. Digital products are for your personal use, as set out in the map use policy, and may not be copied, shared or resold."}]]]}]
4:["$","div","pol_tc6_t",{"children":[["$","h2",null,{"id":"policy-s6","style":{"fontSize":21,"marginBottom":10},"children":[6,". ","Cancellations and refunds"]}],[["$","p","0",{"children":"Bookings are non-refundable, except when the provider cannot run the experience because of force majeure, in which case you receive a full refund. Digital itineraries are non-refundable once delivered. The full rules are in the cancellation and refund policy."}]]]}]
5:["$","div","pol_tc7_t",{"children":[["$","h2",null,{"id":"policy-s7","style":{"fontSize":21,"marginBottom":10},"children":[7,". ","On the day"]}],[["$","p","0",{"children":"Arrive at the meeting point on time, bring what the activity page asks for, and follow the provider's safety instructions. Tell us before booking about any health condition that may affect your participation. A no-show, or arriving too late to take part, counts as a cancellation by you. Your passport, visa and travel insurance are your own responsibility."}]]]}]
6:["$","div","pol_tc8_t",{"children":[["$","h2",null,{"id":"policy-s8","style":{"fontSize":21,"marginBottom":10},"children":[8,". ","Our role and the providers' role"]}],[["$","p","0",{"children":"We present the experiences, take the booking and payment, and pass your details to the provider who runs it. The provider is responsible for carrying out the experience safely and as described. We check the information we publish, but opening hours, routes and conditions can change, especially with the weather."}]]]}]
7:["$","div","pol_tc9_t",{"children":[["$","h2",null,{"id":"policy-s9","style":{"fontSize":21,"marginBottom":10},"children":[9,". ","Changes by the provider and force majeure"]}],[["$","p","0",{"children":"If weather, a natural event, an official order or another cause outside anyone's control (force majeure) stops the provider from running the experience, we will offer another date where possible; if that does not suit you, you receive a full refund. If the provider changes the time or the meeting point, we will tell you as soon as we know."}]]]}]
8:["$","div","pol_tc10_t",{"children":[["$","h2",null,{"id":"policy-s10","style":{"fontSize":21,"marginBottom":10},"children":[10,". ","Liability"]}],[["$","p","0",{"children":"To the extent the law allows, Bali Trips is not liable for indirect losses, or for loss caused by events outside our control or by your not following these terms or the provider's instructions. Nothing in these terms limits a liability that the law does not allow to be limited."}]]]}]
9:["$","div","pol_tc11_t",{"children":[["$","h2",null,{"id":"policy-s11","style":{"fontSize":21,"marginBottom":10},"children":[11,". ","Changes to these terms and contact"]}],[["$","p","0",{"children":"We may update these terms; the date at the top shows the current version, and the version in force when you booked applies to that booking. Questions: hello@balitrips.co or WhatsApp +966 54 881 6380."}]]]}]
