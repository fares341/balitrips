3:["$","div","pol_pr5_t",{"children":[["$","h2",null,{"id":"policy-s5","style":{"fontSize":21,"marginBottom":10},"children":[5,". ","Who we share it with"]}],[["$","p","0",{"children":"The provider who runs your booking receives what they need: name, phone, date, time and number of participants. Stripe processes payments. Hosting, email and messaging services process data on our behalf. Analytics and advertising tools (Google, Meta, TikTok) receive data only if you accept those cookies. We do not sell your personal data."}]]]}]
4:["$","div","pol_pr6_t",{"children":[["$","h2",null,{"id":"policy-s6","style":{"fontSize":21,"marginBottom":10},"children":[6,". ","Transfers abroad"]}],[["$","p","0",{"children":"Our providers are in Indonesia and some of our service providers are in other countries. When your data is sent abroad, we use services that protect it to the standard this policy describes."}]]]}]
5:["$","div","pol_pr7_t",{"children":[["$","h2",null,{"id":"policy-s7","style":{"fontSize":21,"marginBottom":10},"children":[7,". ","How long we keep it"]}],[["$","p","0",{"children":"We keep account data while your account is open. Booking and payment records are kept for as long as accounting and tax law requires. Messages are kept while they are needed to help you. When data is no longer needed, it is deleted or anonymised."}]]]}]
6:["$","div","pol_pr8_t",{"children":[["$","h2",null,{"id":"policy-s8","style":{"fontSize":21,"marginBottom":10},"children":[8,". ","Security"]}],[["$","p","0",{"children":"Connections to the site are encrypted, payments go through Stripe, and access to personal data inside our team is limited to the people who need it."}]]]}]
7:["$","div","pol_pr9_t",{"children":[["$","h2",null,{"id":"policy-s9","style":{"fontSize":21,"marginBottom":10},"children":[9,". ","Your rights"]}],[["$","p","0",{"children":"You can ask for a copy of your data, ask us to correct it, or ask us to delete your account and data (except records we must keep by law). You can object to marketing and change your cookie choice at any time. Send your request to hello@balitrips.co."}]]]}]
8:["$","div","pol_pr10_t",{"children":[["$","h2",null,{"id":"policy-s10","style":{"fontSize":21,"marginBottom":10},"children":[10,". ","Changes to this policy"]}],[["$","p","0",{"children":"When this policy changes, the date at the top changes too. If a change is significant, we will tell you by email or on the site."}]]]}]
