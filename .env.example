# ---------------------------------------------------------------------------
# Bali Trips — environment template.
# Copy to .env.local for development. NEVER commit a filled-in copy.
# On the droplet these live in a root-owned file, not in the image.
# ---------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------
NODE_ENV=development
# Public origin, no trailing slash. Used for canonical URLs, sitemap,
# OAuth callbacks and webhook endpoints.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
# Application schema (Drizzle-owned).
DATABASE_URL=postgresql://bali:bali@localhost:5433/bali

# --- Auth (Better Auth) -------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple. NOTE: Apple refuses localhost and non-HTTPS, so local
# development needs an HTTPS tunnel. APPLE_CLIENT_SECRET is a JWT that
# EXPIRES within ~6 months and must be regenerated — set a calendar reminder.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Admin --------------------------------------------------------------
# Base path for the hidden admin. Never "/admin". Rotatable without a code
# change. Obscurity is the outermost layer only — the real gate is the
# server-side role check on every request.
ADMIN_BASE_PATH=/studio-8f2a

# --- Payload (content CMS, isolated in its own Postgres schema) ---------
PAYLOAD_SECRET=

# --- Object storage (DigitalOcean Spaces, S3-compatible) ---------------
SPACES_REGION=sgp1
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_KEY=
SPACES_SECRET=
# Public bucket: images, CDN on, immutable cache headers.
SPACES_PUBLIC_BUCKET=bali-public
# Private bucket: paid PDFs. CDN OFF. Presigned URLs only, issued after an
# entitlement check. Must never be publicly readable.
SPACES_PRIVATE_BUCKET=bali-private
# Custom CDN hostname in front of the public bucket.
NEXT_PUBLIC_CDN_URL=

# --- Email (Resend) -----------------------------------------------------
# Use a dedicated sending subdomain, separate from marketing. Since Nov 2025,
# mail without SPF+DKIM+DMARC and a valid PTR is rejected outright at volume.
RESEND_API_KEY=
EMAIL_FROM="Bali Trips <bookings@mail.example.com>"

# --- PDF rendering (Gotenberg sidecar) ---------------------------------
# Chromium-backed because it is the only engine that renders mixed
# Arabic/English correctly. Called from the worker only, never the web app.
GOTENBERG_URL=http://gotenberg:3000

# --- Bookings kill switch ------------------------------------------------
# Opt-IN. Unset, empty, "TRUE", "1" and "yes" all mean bookings are CLOSED:
# checkout() and addItem() refuse, the sandbox 3-D Secure stand-in 404s, and
# the cart and checkout pages show "bookings open soon" in en/ar/id. Browsing,
# prices, quotes, lead capture and cart teardown are untouched.
#
# Opt-in rather than a DISABLE_ flag on purpose. Taking an order is the
# dangerous capability while no real PSP exists -- SandboxPaymentProvider
# reports success without money moving -- so a box that lost its env file, a
# rolled-back container or a typo must all fail CLOSED. The worst case of any
# misconfiguration is then "browsable but nobody can book".
#
# Runtime only. Never a build ARG and never NEXT_PUBLIC_: flipping it must be
# a container restart, not an image rebuild, and it is a server gate rather
# than a hint to the browser.
ALLOW_BOOKINGS=

# --- Payments -----------------------------------------------------------
# stripe (production) | sandbox (development only, needs ALLOW_SANDBOX_PAYMENTS).
# Stripe keys are in the Stripe section below.
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=

# --- WhatsApp hand-off --------------------------------------------------
# Digits only, E.164 without the leading '+' (8-15 digits) — wa.me rejects
# spaces, dashes and '+'. The custom-trip page withholds its "Finalize on
# WhatsApp" button entirely when this is unset or malformed, rather than
# shipping a dead link. The prototype hard-coded a 16-digit placeholder.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- AI assistants (OpenRouter) -----------------------------------------
# Server-only secret: read per request by src/lib/assistant/config.ts and never
# sent to the browser (no NEXT_PUBLIC_ prefix). Empty = both assistants show a
# polite "unavailable" state and the rest of the site works as usual.
# Get a key at https://openrouter.ai/keys (set a credit limit on the key).
OPENROUTER_API_KEY=
# Optional overrides. Studio → Assistant → Settings wins over these; empty =
# google/gemini-2.5-flash with openai/gpt-6-luna as the fallback.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
# Tests only (the CI mock server). Must be https, or http on localhost.
OPENROUTER_BASE_URL=
# Days a chat is kept before the worker deletes it (default 90).
ASSISTANT_RETENTION_DAYS=90

# --- Observability ------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Background worker (`pnpm worker`, src/worker/) ---------------------
# All optional; the defaults are what production should run. The worker
# REFUSES TO START when a required variable is missing rather than failing
# later inside a job — DATABASE_URL always, and in production also
# NEXT_PUBLIC_SITE_URL, RESEND_API_KEY, EMAIL_FROM, GOTENBERG_URL and the
# SPACES_* set. It names the variable and the queue it breaks.

# How long in-flight jobs get to finish after SIGTERM/SIGINT, in ms.
# The container's stop_grace_period MUST be larger than this (compose sets
# 45s) or Docker SIGKILLs the process mid-drain. Anything still running when
# this expires is failed back to the queue for retry and the worker exits
# non-zero, so a killed render is visible to the orchestrator.
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# Parallel mail sends. PDF work is hard-capped at 1 and is not configurable:
# a Chromium render peaks near 1.5 GiB on a 4 GiB box shared with Postgres.
WORKER_EMAIL_CONCURRENCY=4

# Set to false to stop this worker registering the cron sweeps (reconcile
# every 5m, capacity expiry every 10m, itinerary PDF sweep hourly). Only
# useful when running a second worker that should consume but not schedule.
WORKER_SCHEDULES=true

# Treat a missing deploy-time variable as fatal in development too. Always on
# when NODE_ENV=production. Turn it on locally to prove a deploy would boot.
WORKER_STRICT_ENV=false

# Force the mail transport instead of inferring it from RESEND_API_KEY.
# "console" prints messages and reports success — the development default,
# and a silent data-loss hazard if it is ever reached in production, which is
# why RESEND_API_KEY is a hard requirement there.
EMAIL_TRANSPORT=

# Real server that takes real money. When true, ALLOW_SANDBOX_PAYMENTS and
# DISABLE_ADMIN_2FA are ignored whatever their value. Leave empty locally.
LIVE_MODE=

# Runtime gate for the sandbox payment provider and its 3-D Secure stand-in.
# NEVER set this on a server that takes real money. Gated at runtime rather
# than on NODE_ENV, which Next inlines at build time.
ALLOW_SANDBOX_PAYMENTS=

# ---------------------------------------------------------------------------
# Security / anti-sharing (batch 1)
# ---------------------------------------------------------------------------
# Devices a customer may be signed in on when no entitlement sets device_limit.
DEFAULT_DEVICE_LIMIT=2
# What happens when a new device would exceed the limit:
#   block        refuse sign-in; user removes a device from /account/devices (default)
#   evict_oldest sign the least-recently-used device out and accept the new one
#   require_approval  hold the device as pending; an admin approves it in
#                Studio → Protection → Devices, then the customer signs in again
#   warn         accept and record it in the activity log
SECURITY_NEW_DEVICE_POLICY=block
# Header carrying the real client IP. Leave empty behind Caddy alone (the last
# X-Forwarded-For hop is used). Set to cf-connecting-ip ONLY if the origin
# accepts connections from Cloudflare exclusively.
TRUSTED_IP_HEADER=
# Header carrying the visitor's country for the login log (default cf-ipcountry,
# set by Cloudflare). Leave empty when no CDN adds one; country is then blank.
GEO_COUNTRY_HEADER=
# City header (Cloudflare: Rules → Managed Transforms → "Add visitor location headers").
GEO_CITY_HEADER=
# Lifetime of presigned PDF links, seconds (30–900).
DOWNLOAD_URL_TTL_SECONDS=120

# ---------------------------------------------------------------------------
# Security batch 2
# ---------------------------------------------------------------------------
# Days of activity_log kept by the nightly security.prune job (min 7).
ACTIVITY_RETENTION_DAYS=180
# Device policy, download policy and automatic bans are edited in
# Studio → Protection → Settings (site_settings key "security"). The two
# batch-1 variables above remain the defaults until that form is saved once.

# ---------------------------------------------------------------------------
# Batch 4 — payments, notifications
# ---------------------------------------------------------------------------
# Real payments: PAYMENT_PROVIDER=stripe (sandbox stays available for dev).
# Webhook endpoint in the Stripe dashboard: https://<domain>/api/payments/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp Business (Meta Cloud API). Empty = WhatsApp is skipped silently.
# Templates named <prefix><type> (e.g. bali_order_paid) must be approved in
# Meta Business Manager in ar / en / id first — see docs/batch4.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_PREFIX=bali_

# Team alerts. Comma-separated; empty = every admin account.
STAFF_ALERT_EMAILS=
# International number for urgent team WhatsApp alerts (+9665…).
STAFF_WHATSAPP_NUMBER=

# Blue/green: both colours must share one key, or a visitor whose page was
# rendered by the old colour gets failed form submissions after the swap.
# openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Phase 6: supplier integrations, system health ---------------------------
# Supplier API keys and webhook secrets are encrypted with the same key as
# the marketing tokens: INTEGRATION_SECRET_KEY (or derived from BETTER_AUTH_SECRET).
# Bearer token for /api/health/deep (uptime monitors). 24+ characters; empty =
# only a signed-in admin can read it. /api/health stays a plain liveness check.
HEALTH_CHECK_TOKEN=
# New errors per 15 minutes that trigger an "error spike" alert (default 50).
ERROR_SPIKE_THRESHOLD=
