# Normalize line endings so Windows/macOS/Linux and CI agree.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe misreads labels and GOTO.
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated — collapse in diffs and exclude from language stats.
pnpm-lock.yaml linguist-generated=true -diff
messages/*.json linguist-generated=true

# Design reference is not our code.
design/** linguist-vendored=true
