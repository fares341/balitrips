# env — never commit real secrets
.env
.env*.local
.env.production
!.env.example

# Derived env files, written beside docker-compose.prod.yml on the server.
# They hold POSTGRES_PASSWORD, BETTER_AUTH_SECRET, PAYLOAD_SECRET and the
# payment webhook secret in plaintext. They sit inside the working tree only
# because the compose file must reference them as ./app.env — so without
# these three lines, one `git add -A` run on the box publishes every secret
# in the deployment to GitHub.
app.env
caddy.env
postgres.env

# Database dumps at the repo root: they hold password hashes and live session
# tokens. Root-only (leading slash) — drizzle/*.sql migrations must stay tracked.
/*.sql
/*.sql.gz
/*.dump
