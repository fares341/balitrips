# ============================================================================
# Production environment template — copy to .env.production ON THE SERVER only.
# Generate every secret on the box:  openssl rand -base64 32
# Never commit the filled file, never copy it into the repo or an image.
# ============================================================================

# Locks out development escape hatches (sandbox payments, disabling admin 2FA)
# regardless of what else is set below. Required on the real server.
LIVE_MODE=true
NODE_ENV=production

APP_IMAGE_BLUE=
APP_IMAGE_GREEN=
WORKER_IMAGE=

SITE_DOMAIN=balitrips.co
NEXT_PUBLIC_SITE_URL=https://balitrips.co
ACME_EMAIL=

POSTGRES_USER=bali
POSTGRES_PASSWORD=
POSTGRES_DB=bali
DATABASE_URL=postgresql://bali:<POSTGRES_PASSWORD>@postgres:5432/bali

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://balitrips.co
# Shared by blue and green so a form opened before a swap still submits.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

ADMIN_BASE_PATH=/studio-<openssl rand -hex 4>

# Payments — stripe in production. Sandbox is refused in LIVE_MODE.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=

GOTENBERG_URL=http://gotenberg:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_CONTACT_EMAIL=hello@balitrips.co
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DISPLAY=

# Email — required: password reset and receipts depend on it.
RESEND_API_KEY=
EMAIL_FROM=Bali Trips <bookings@balitrips.co>

# Object storage — two buckets in SGP1, separate keys.
SPACES_REGION=sgp1
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_KEY=
SPACES_SECRET=
SPACES_PUBLIC_BUCKET=bali-public
SPACES_PRIVATE_BUCKET=bali-private

# Client IP source. "cf-connecting-ip" when Cloudflare proxies the domain
# (orange cloud), otherwise "x-forwarded-for" (Caddy terminates TLS directly).
TRUSTED_IP_HEADER=x-forwarded-for
# Country of a sign-in for the login log. Cloudflare sends cf-ipcountry.
GEO_COUNTRY_HEADER=cf-ipcountry
# Needs Cloudflare Managed Transform "Add visitor location headers".
GEO_CITY_HEADER=cf-ipcity

WORKER_SHUTDOWN_TIMEOUT_MS=30000
WORKER_EMAIL_CONCURRENCY=4
WORKER_SCHEDULES=true
